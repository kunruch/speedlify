---
layout: layout.njk
---
<h1 class="speedlify-hed">Speedlify Dashboard</h1>

<div class="categories-summary">
  {% for categoryName, category in sites %}
    {% if not category.hide %}
      {% set categoryUrls = results | getSites(sites, categoryName) %}
      {% set totalSites = categoryUrls.length %}
      {% set totalPerformance = 0 %}
      {% set totalAccessibility = 0 %}
      {% set totalBestPractices = 0 %}
      {% set totalSEO = 0 %}
      {% for site in categoryUrls %}
        {% set newestKey = site | getObjectKey(":newest") %}
        {% if site[newestKey].lighthouse %}
          {% set totalPerformance = totalPerformance + site[newestKey].lighthouse.performance %}
          {% set totalAccessibility = totalAccessibility + site[newestKey].lighthouse.accessibility %}
          {% set totalBestPractices = totalBestPractices + site[newestKey].lighthouse.bestPractices %}
          {% set totalSEO = totalSEO + site[newestKey].lighthouse.seo %}
        {% endif %}
      {% endfor %}
      {% set avgPerformance = 0 %}
      {% set avgAccessibility = 0 %}
      {% set avgBestPractices = 0 %}
      {% set avgSEO = 0 %}
      {% if totalSites > 0 %}
        {% set avgPerformance = (totalPerformance / totalSites * 100) | round %}
        {% set avgAccessibility = (totalAccessibility / totalSites * 100) | round %}
        {% set avgBestPractices = (totalBestPractices / totalSites * 100) | round %}
        {% set avgSEO = (totalSEO / totalSites * 100) | round %}
      {% endif %}
      <div class="category-card">
        <h2>{{ category.description or category.name or categoryName }}</h2>
        <p>{{ totalSites }} URLs</p>
        <dl class="category-stats">
          <div class="category-stats-entry">
            <dt>Performance</dt>
            <dd>
              <span class="leaderboard-score-circles">
                <span class="leaderboard-score-circle {% if avgPerformance >= 90 %}leaderboard-score-circle-green{% elif avgPerformance >= 50 %}leaderboard-score-circle-yellow{% else %}leaderboard-score-circle-red{% endif %}"></span>
              </span>
              {{ avgPerformance }}
            </dd>
          </div>
          <div class="category-stats-entry">
            <dt>Accessibility</dt>
            <dd>
              <span class="leaderboard-score-circles">
                <span class="leaderboard-score-circle {% if avgAccessibility >= 90 %}leaderboard-score-circle-green{% elif avgAccessibility >= 50 %}leaderboard-score-circle-yellow{% else %}leaderboard-score-circle-red{% endif %}"></span>
              </span>
              {{ avgAccessibility }}
            </dd>
          </div>
          <div class="category-stats-entry">
            <dt>Best Practices</dt>
            <dd>
              <span class="leaderboard-score-circles">
                <span class="leaderboard-score-circle {% if avgBestPractices >= 90 %}leaderboard-score-circle-green{% elif avgBestPractices >= 50 %}leaderboard-score-circle-yellow{% else %}leaderboard-score-circle-red{% endif %}"></span>
              </span>
              {{ avgBestPractices }}
            </dd>
          </div>
          <div class="category-stats-entry">
            <dt>SEO</dt>
            <dd>
              <span class="leaderboard-score-circles">
                <span class="leaderboard-score-circle {% if avgSEO >= 90 %}leaderboard-score-circle-green{% elif avgSEO >= 50 %}leaderboard-score-circle-yellow{% else %}leaderboard-score-circle-red{% endif %}"></span>
              </span>
              {{ avgSEO }}
            </dd>
          </div>
        </dl>
        <a href="{{ ('/' + (category.name or categoryName) | lower | slug + '/') | url }}">View Details</a>
      </div>
    {% endif %}
  {% endfor %}
</div>
